<idea-plugin>
  <id>com.chenying.inputvariation</id>
  <name>Input Variation Switcher</name>
  <version>1.1</version>
  <vendor email="support@chenying.com" url="http://www.cykj.com">尘萦科技</vendor>

  <description><![CDATA[
      该插件提供以下功能：<br>
      1. 在写注释的时候自动切换成中文输入法，并将光标变成红色<br>
      2. 在写代码的时候自动切换成英文输入法，并将光标恢复默认颜色<br>
      <br>
      该插件能够实时监测当前编辑内容，自动判断用户是否正在编写注释，从而自动切换输入法和光标颜色，
      有效提高中英文混合编码的效率，无需手动切换输入法。
    ]]></description>

  <change-notes><![CDATA[
      版本 1.1:<br>
      <ul>
        <li>改进注释区域的检测机制，更准确识别各种类型的注释</li>
        <li>优化输入法切换逻辑，提高响应速度和准确性</li>
        <li>直接修改编辑器配色方案，使光标颜色变化更加可靠</li>
        <li>添加延迟处理机制，避免频繁切换输入法</li>
      </ul>
      <br>
      版本 1.0:<br>
      <ul>
        <li>支持在编写注释时自动切换至中文输入法</li>
        <li>支持在编写代码时自动切换至英文输入法</li>
        <li>支持在注释区域将光标变为红色，增强视觉提示</li>
      </ul>
    ]]>
  </change-notes>

  <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html for description -->
  <idea-version since-build="173.0"/>

  <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
       on how to target different products -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Add your extensions here -->
    <postStartupActivity implementation="com.chenying.inputvariation.InputMethodSwitcher"/>
  </extensions>

  <project-components>
  </project-components>

  <actions>
    <!-- Add your actions here -->
  </actions>

</idea-plugin>